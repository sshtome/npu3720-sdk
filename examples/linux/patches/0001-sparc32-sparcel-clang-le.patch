--- a/scripts/Makefile.clang
+++ b/scripts/Makefile.clang
@@ -10,6 +10,7 @@
 CLANG_TARGET_FLAGS_powerpc	:= powerpc64le-linux-gnu
 CLANG_TARGET_FLAGS_riscv	:= riscv64-linux-gnu
 CLANG_TARGET_FLAGS_s390		:= s390x-linux-gnu
+CLANG_TARGET_FLAGS_sparc	:= sparcel-unknown-elf
 CLANG_TARGET_FLAGS_x86		:= x86_64-linux-gnu
 CLANG_TARGET_FLAGS_um		:= $(CLANG_TARGET_FLAGS_$(SUBARCH))
 CLANG_TARGET_FLAGS		:= $(CLANG_TARGET_FLAGS_$(SRCARCH))
--- a/arch/sparc/Makefile
+++ b/arch/sparc/Makefile
@@ -21,7 +21,11 @@
 #
 
 CHECKFLAGS     += -D__sparc__
+ifeq ($(CONFIG_CPU_LITTLE_ENDIAN),y)
+KBUILD_LDFLAGS := -m elf32_sparcel
+else
 KBUILD_LDFLAGS := -m elf32_sparc
+endif
 export BITS    := 32
 UTS_MACHINE    := sparc
 
@@ -29,7 +33,7 @@
 # versions of gcc.  Some gcc versions won't pass -Av8 to binutils when you
 # give -mcpu=v8.  This silently worked with older bintutils versions but
 # does not any more.
-KBUILD_CFLAGS  += -m32 -mcpu=v8 -pipe -mno-fpu -fcall-used-g5 -fcall-used-g7
+KBUILD_CFLAGS  += -m32 -mcpu=v8 -pipe -mno-fpu $(call cc-option,-fcall-used-g5) $(call cc-option,-fcall-used-g7)
 KBUILD_CFLAGS  += -Wa,-Av8
 
 KBUILD_AFLAGS  += -m32 -Wa,-Av8
--- a/arch/sparc/Kconfig
+++ b/arch/sparc/Kconfig
@@ -110,7 +110,11 @@
 	def_bool y
 
 config CPU_BIG_ENDIAN
-	def_bool y
+	def_bool y if !CPU_LITTLE_ENDIAN
+
+config CPU_LITTLE_ENDIAN
+	bool "Little endian"
+	default n
 
 config ARCH_ATU
 	bool
--- a/arch/sparc/include/uapi/asm/byteorder.h
+++ b/arch/sparc/include/uapi/asm/byteorder.h
@@ -2,6 +2,10 @@
 #ifndef _SPARC_BYTEORDER_H
 #define _SPARC_BYTEORDER_H
 
+#if defined(__LITTLE_ENDIAN) || defined(__LITTLE_ENDIAN__) || defined(CONFIG_CPU_LITTLE_ENDIAN)
+#include <linux/byteorder/little_endian.h>
+#else
 #include <linux/byteorder/big_endian.h>
+#endif
 
 #endif /* _SPARC_BYTEORDER_H */
--- a/arch/sparc/include/asm/psr.h
+++ b/arch/sparc/include/asm/psr.h
@@ -55,10 +55,10 @@
 	unsigned int fsr = 0;
 
 	__asm__ __volatile__(
-		"st	%%fsr, %1\n\t"
-		"ld	%1, %0\n\t"
+		"st	%%fsr, [%1]\n\t"
+		"ld	[%1], %0\n\t"
 	: "=r" (fsr)
-	: "m" (fsr_storage));
+	: "r" (&fsr_storage));
 
 	return fsr;
 }
--- a/arch/sparc/kernel/vmlinux.lds.S
+++ b/arch/sparc/kernel/vmlinux.lds.S
@@ -22,7 +22,11 @@
 #define SMP_CACHE_BYTES (1 << SMP_CACHE_BYTES_SHIFT)
 
 #ifdef CONFIG_SPARC32
+#ifdef CONFIG_CPU_LITTLE_ENDIAN
+OUTPUT_FORMAT("elf32-sparcel", "elf32-sparcel", "elf32-sparcel")
+#else
 OUTPUT_FORMAT("elf32-sparc", "elf32-sparc", "elf32-sparc")
+#endif
 OUTPUT_ARCH(sparc)
 ENTRY(_start)
 jiffies = jiffies_64 + 4;
